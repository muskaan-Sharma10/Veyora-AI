# Copy this file to .env and replace the placeholders with your own settings.
# Never put real keys or passwords in .env.example.

# Google Gemini API key from https://aistudio.google.com/app/apikey
# Optional: without a key every agent uses its deterministic local fallback.
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.8-flash
# Per-request timeout in milliseconds
GEMINI_TIMEOUT_MS=30000

# Screening Decision Agent: shortlist at or above this score, reject below it.
SCREENING_THRESHOLD=60

# Local Flask settings
FLASK_SECRET_KEY=
FLASK_DEBUG=false
FLASK_PORT=5000

# Optional email invitations. Leave blank until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
